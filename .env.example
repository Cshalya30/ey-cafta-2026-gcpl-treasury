# ─────────────────────────────────────────────────────────────
# GCPL Treasury Command — environment template
# Copy to .env and edit. .env is gitignored and must never be committed.
# This application holds SYNTHETIC data only and initiates no payments,
# so it has no payment, bank or market-data credentials by design.
# ─────────────────────────────────────────────────────────────

# Absolute or project-relative path to the generated SQLite file.
GCPL_DB_PATH=data/gcpl.db

# Comma-separated exact origins allowed to call the API.
# Never use "*" — the API echoes persona-scoped financial data.
GCPL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# dev | prod. "prod" disables /docs, enables HSTS and strict cookies.
GCPL_ENV=dev

# Signing key for the demo session cookie. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset in dev and a random per-boot key is used.
GCPL_SESSION_SECRET=

# Set to 1 only behind a TLS terminator. Forces Secure cookies + HTTPS redirect.
GCPL_FORCE_HTTPS=0
